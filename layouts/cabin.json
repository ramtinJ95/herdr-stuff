{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [
    12,
    9
  ],
  "toast": "cabin",
  "background": "canvas",
  "terminal_padding": [
    10,
    8
  ],
  "floating": [
    {
      "id": "terminal-chrome",
      "content": {
        "mod": "terminal-chrome",
        "props": {
          "enabled": true
        }
      },
      "edge": "bottom",
      "align": "end"
    }
  ],
  "children": [
    {
      "id": "beam",
      "type": "block",
      "size": {
        "px": 52
      },
      "window_drag": true,
      "content": {
        "mod": "cabin",
        "props": {
          "role": "beam"
        }
      }
    },
    {
      "id": "middle",
      "type": "row",
      "resizable": false,
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "size": {
            "px": 300
          },
          "min": 52,
          "max": 480,
          "resizable": false,
          "children": [
            {
              "id": "board",
              "type": "block",
              "size": {
                "weight": 0.8
              },
              "min": 120,
              "content": {
                "mod": "cabin",
                "props": {
                  "role": "board"
                }
              }
            },
            {
              "id": "hearth",
              "type": "block",
              "size": {
                "px": 230
              },
              "content": {
                "mod": "cabin",
                "props": {
                  "role": "hearth"
                }
              }
            },
            {
              "id": "den",
              "type": "block",
              "size": {
                "weight": 1.5
              },
              "min": 120,
              "content": {
                "mod": "cabin",
                "props": {
                  "role": "den"
                }
              }
            }
          ]
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 12,
          "gap": 10,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 10,
                  "radius": 0,
                  "background": "background",
                  "border": {
                    "width": 5,
                    "color": "border"
                  },
                  "focus": {
                    "width": 5,
                    "color": "accent"
                  },
                  "lone": true,
                  "header": {
                    "content": {
                      "mod": "cabin",
                      "props": {
                        "role": "titlebar"
                      }
                    },
                    "height": 38,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "counter",
      "type": "block",
      "size": {
        "px": 46
      },
      "window_drag": true,
      "content": {
        "mod": "cabin",
        "props": {
          "role": "counter"
        }
      }
    }
  ]
}
